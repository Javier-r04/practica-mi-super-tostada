# Next.js standalone. `next dev` local no usa esta imagen.
FROM oven/bun:1.3-debian AS deps
WORKDIR /app
COPY package.json bun.lock ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/pdf/package.json packages/pdf/package.json
RUN bun install --frozen-lockfile

FROM oven/bun:1.3-debian AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY package.json bun.lock ./
COPY apps/web apps/web
COPY packages/shared packages/shared
# WEB_ORIGIN basta si sigue app.* → api.* (Openship no siempre pasa build args).
ARG WEB_ORIGIN=""
ARG NEXT_PUBLIC_API_URL=""
ENV NEXT_TELEMETRY_DISABLED=1
RUN set -eu; \
  if [ -n "$NEXT_PUBLIC_API_URL" ]; then \
    API_URL="$NEXT_PUBLIC_API_URL"; \
  elif [ -n "$WEB_ORIGIN" ]; then \
    API_URL=$(printf '%s' "$WEB_ORIGIN" | sed 's|//app\.|//api.|'); \
  else \
    echo "Falta NEXT_PUBLIC_API_URL o WEB_ORIGIN como build arg" >&2; \
    exit 1; \
  fi; \
  echo "NEXT_PUBLIC_API_URL=$API_URL"; \
  NEXT_PUBLIC_API_URL="$API_URL" bun run --filter web build

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
ENV NODE_OPTIONS=--max-old-space-size=384
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/.next/static ./.next/static
COPY --from=build /app/apps/web/public ./apps/web/public
COPY --from=build /app/apps/web/public ./public
COPY deploy/entrypoint-web.sh /app/entrypoint-web.sh
RUN chmod +x /app/entrypoint-web.sh
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=8 \
  CMD node -e "fetch('http://127.0.0.1:3000/login').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["/app/entrypoint-web.sh"]
