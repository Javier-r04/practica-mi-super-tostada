# Copiar estas claves en Openship → proyecto → Environment.
# No commitear valores reales. Generar secretos en el Mac, no en el VPS.

NODE_ENV=production

# Postgres interno (no se publica). 32+ caracteres.
POSTGRES_PASSWORD=

# URLs públicas HTTPS (Let's Encrypt las emite Openship).
# Panel + portal en `web`; API en `api`. Mismo dominio registrable (cookies SameSite=Lax).
WEB_ORIGIN=https://app.TU-DOMINIO
NEXT_PUBLIC_API_URL=https://api.TU-DOMINIO

# 32 bytes hex:  openssl rand -hex 32
APP_ENCRYPTION_KEY=

# Cloudflare R2 (obligatorio en production)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com

# Primer ADMIN_JEFE. Solo se crea si la tabla usuario está vacía.
BOOTSTRAP_ADMIN_USERNAME=cristian
BOOTSTRAP_ADMIN_PASSWORD=

# true solo en el primer deploy (catálogo + feriados + clientes de CONTEXT.md §5).
# Después déjalo en false: el seed actualiza productos oficiales en cada boot.
SEED_ON_BOOT=true

# WhatsApp — opcional. Sin esto sigue el Fake adapter.
# META_APP_ID=
# META_APP_SECRET=
# META_CONFIG_ID=
# META_VERIFY_TOKEN=
# META_GRAPH_VERSION=v21.0
