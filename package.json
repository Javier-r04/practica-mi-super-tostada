{
  "name": "misupertostada",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter web dev",
    "dev:api": "bun run --filter api start:dev",
    "dev:all": "bun run scripts/dev-all.ts",
    "build": "bun run --filter web build && bun run --filter api build",
    "lint": "bun run --filter web lint",
    "test": "bun test",
    "typecheck": "bun run --filter api typecheck && bun run --filter web typecheck",
    "db:create": "bun packages/db/src/create-db.ts",
    "db:migrate": "bun run --filter @misupertostada/db migrate",
    "db:seed": "bun packages/db/src/seed.ts",
    "db:setup": "bun run db:create && bun run db:migrate && bun run db:seed",
    "db:up": "docker compose up -d"
  },
  "packageManager": "bun@1.3.13"
}
